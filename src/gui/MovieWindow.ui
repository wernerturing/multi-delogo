<interface>
  <!-- interface-name multi-delogo -->
  <!-- interface-copyright 2018-2026 Werner Turing <werner.turing@protonmail.com> -->
  <!-- interface-license-id gpl_3_0 -->
  <requires lib="gio" version="2.0"/>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkApplicationWindow" id="movie_window">
    <property name="default-height">650</property>
    <property name="default-width">1400</property>
    <child>
      <object class="GtkBox" id="box_main">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="toolbar">
            <property name="margin-start">8</property>
            <property name="spacing">16</property>
            <child>
              <object class="GtkButton" id="btn_new">
                <property name="action-name">app.new</property>
                <property name="has-frame">0</property>
                <property name="icon-name">document-new</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_open">
                <property name="action-name">app.open</property>
                <property name="has-frame">0</property>
                <property name="icon-name">document-open</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_save">
                <property name="action-name">win.save</property>
                <property name="has-frame">0</property>
                <property name="icon-name">document-save</property>
              </object>
            </child>
            <child>
              <object class="GtkSeparator" id="sep1"/>
            </child>
            <child>
              <object class="GtkButton" id="btn_undo">
                <property name="action-name">win.undo</property>
                <property name="has-frame">0</property>
                <property name="icon-name">edit-undo</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_redo">
                <property name="action-name">win.redo</property>
                <property name="has-frame">0</property>
                <property name="icon-name">edit-redo</property>
              </object>
            </child>
            <child>
              <object class="GtkSeparator" id="sep2"/>
            </child>
            <child>
              <object class="GtkToggleButton" id="chk_scroll_filter">
                <property name="active">1</property>
                <property name="has-frame">0</property>
                <property name="label">_Scroll to filter</property>
                <property name="margin-start">2</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="btn_prev_frame">
                <property name="has-frame">0</property>
                <property name="menu-model">mnu_prev_frame</property>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">_Previous frame</property>
                        <property name="mnemonic-widget">btn_prev_frame</property>
                        <property name="use-underline">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">pan-down-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator" id="sep3"/>
            </child>
            <child>
              <object class="GtkButton" id="btn_find_logos">
                <property name="action-name">win.find-logos</property>
                <property name="has-frame">0</property>
                <property name="icon-name">edit-find</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_encode">
                <property name="action-name">win.encode</property>
                <property name="has-frame">0</property>
                <property name="label">_Encode</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <style>
              <class name="toolbar"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="box_content">
            <property name="margin-bottom">6</property>
            <property name="margin-end">6</property>
            <property name="margin-start">6</property>
            <property name="margin-top">6</property>
            <property name="spacing">8</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkBox" id="filter_list">
                <property name="orientation">vertical</property>
                <property name="spacing">8</property>
                <child>
                  <object class="GtkScrolledWindow" id="scr_filter_view">
                    <property name="child">
                      <object class="GtkTreeView" id="filter_view">
                        <property name="enable-search">0</property>
                        <property name="focusable">1</property>
                      </object>
                    </property>
                    <property name="focusable">1</property>
                    <property name="has-frame">True</property>
                    <property name="min-content-height">225</property>
                    <property name="min-content-width">200</property>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid" id="grid_filter_list_buttons">
                    <property name="column-homogeneous">1</property>
                    <property name="column-spacing">4</property>
                    <property name="row-spacing">4</property>
                    <child>
                      <object class="GtkButton" id="btn_prev_filter">
                        <property name="focusable">1</property>
                        <property name="icon-name">go-previous</property>
                        <property name="receives-default">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_remove_filter">
                        <property name="focusable">1</property>
                        <property name="icon-name">list-remove</property>
                        <property name="receives-default">1</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_next_filter">
                        <property name="focusable">1</property>
                        <property name="icon-name">go-next</property>
                        <property name="receives-default">1</property>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_shift">
                        <property name="focusable">1</property>
                        <property name="label" translatable="yes">_Shift starting frames...</property>
                        <property name="receives-default">1</property>
                        <property name="use-underline">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="column-span">3</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid" id="filter_type">
                    <property name="column-spacing">4</property>
                    <property name="margin-top">8</property>
                    <child>
                      <object class="GtkLabel" id="lbl_filter_type">
                        <property name="label" translatable="yes">Filter:</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="rad_delogo">
                        <property name="active">True</property>
                        <property name="focusable">1</property>
                        <property name="halign">start</property>
                        <property name="label">delogo</property>
                        <property name="use-underline">True</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="rad_drawbox">
                        <property name="focusable">1</property>
                        <property name="group">rad_delogo</property>
                        <property name="halign">start</property>
                        <property name="label">drawbox</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="rad_cut">
                        <property name="focusable">1</property>
                        <property name="group">rad_delogo</property>
                        <property name="halign">start</property>
                        <property name="label">cut</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="rad_none">
                        <property name="focusable">1</property>
                        <property name="group">rad_delogo</property>
                        <property name="halign">start</property>
                        <property name="label">none</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="rad_review">
                        <property name="focusable">1</property>
                        <property name="group">rad_delogo</property>
                        <property name="halign">start</property>
                        <property name="label">review</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">5</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="rad_speed">
                        <property name="focusable">1</property>
                        <property name="group">rad_delogo</property>
                        <property name="halign">start</property>
                        <property name="label">speed</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="frame_navigator">
                <property name="hexpand">1</property>
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <child>
                  <object class="GtkGrid" id="grid_frame_view">
                    <property name="column-homogeneous">1</property>
                    <property name="column-spacing">4</property>
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkScrolledWindow" id="frame_view">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="prev_frame_view">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbl_prev_frame">
                        <property name="label" translatable="yes">Previous frame:</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box_frame_navigator_bottom">
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkBox" id="box_frame_navigator_navigation">
                        <property name="hexpand">1</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkButton" id="btn_prev_jump">
                            <property name="focusable">1</property>
                            <property name="label">&lt;&lt;</property>
                            <property name="receives-default">1</property>
                            <property name="tooltip-text" translatable="yes">Jump back the number of frames specified in "jump size" (a)</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_prev">
                            <property name="focusable">1</property>
                            <property name="label">&lt;</property>
                            <property name="receives-default">1</property>
                            <property name="tooltip-text" translatable="yes">Move back one frame (s)</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="txt_frame_number">
                            <property name="focusable">1</property>
                            <property name="input-purpose">digits</property>
                            <property name="max-width-chars">5</property>
                            <property name="tooltip-text" translatable="yes">Current frame number</property>
                            <property name="width-chars">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_number_of_frames">
                            <property name="label">/ 1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_next">
                            <property name="focusable">1</property>
                            <property name="label">&gt;</property>
                            <property name="receives-default">1</property>
                            <property name="tooltip-text" translatable="yes">Move forward one frame (d)</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_next_jump">
                            <property name="focusable">1</property>
                            <property name="label">&gt;&gt;</property>
                            <property name="receives-default">1</property>
                            <property name="tooltip-text" translatable="yes">Jump forward the number of frames specified in "jump size" (f)</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_jump_size">
                            <property name="label" translatable="yes">_Jump size:</property>
                            <property name="margin-start">32</property>
                            <property name="mnemonic-widget">txt_jump_size</property>
                            <property name="use-underline">1</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="txt_jump_size">
                            <property name="focusable">1</property>
                            <property name="input-purpose">digits</property>
                            <property name="max-width-chars">5</property>
                            <property name="tooltip-text" translatable="yes">Number of frames to jump when using &lt;&lt; and &gt;&gt; buttons</property>
                            <property name="width-chars">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_time_pos">
                            <property name="label">00:00.000</property>
                            <property name="margin-start">64</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_time_separator">
                            <property name="label">/</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_time_total">
                            <property name="label">10:00.000</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="box_frame_navigator_zoom">
                        <property name="spacing">8</property>
                        <property name="valign">start</property>
                        <child>
                          <object class="GtkButton" id="btn_zoom_fit">
                            <property name="focusable">1</property>
                            <property name="icon-name">zoom-fit-best</property>
                            <property name="receives-default">1</property>
                            <property name="tooltip-text" translatable="yes">Fit the image to the window</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_zoom_out">
                            <property name="focusable">1</property>
                            <property name="icon-name">zoom-out</property>
                            <property name="receives-default">1</property>
                            <property name="tooltip-text" translatable="yes">Make image smaller</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_zoom">
                            <property name="label">100%</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_zoom_in">
                            <property name="focusable">1</property>
                            <property name="icon-name">zoom-in</property>
                            <property name="receives-default">1</property>
                            <property name="sensitive">0</property>
                            <property name="tooltip-text" translatable="yes">Make image larger</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_zoom_100">
                            <property name="focusable">1</property>
                            <property name="icon-name">zoom-original</property>
                            <property name="receives-default">1</property>
                            <property name="sensitive">0</property>
                            <property name="tooltip-text" translatable="yes">Zoom to original size</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <menu id="mnu_prev_frame">
    <section id="mnu_prev_frame_section">
      <item>
        <attribute name="action">win.set-prev-frame</attribute>
        <attribute name="label">_Don't display</attribute>
        <attribute name="target">NO</attribute>
      </item>
      <item>
        <attribute name="action">win.set-prev-frame</attribute>
        <attribute name="label">_Fit to window</attribute>
        <attribute name="target">FIT</attribute>
      </item>
      <item>
        <attribute name="action">win.set-prev-frame</attribute>
        <attribute name="label">_Same view</attribute>
        <attribute name="target">SAME</attribute>
      </item>
    </section>
  </menu>
</interface>
