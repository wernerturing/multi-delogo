<interface>
  <!-- interface-name multi-delogo -->
  <!-- interface-copyright 2018-2026 Werner Turing <werner.turing@protonmail.com> -->
  <!-- interface-license-id gpl_3_0 -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkApplicationWindow" id="find_logos_window">
    <property name="title" translatable="yes">Find logos</property>
    <child>
      <object class="GtkBox" id="box_main">
        <property name="margin-bottom">8</property>
        <property name="margin-end">8</property>
        <property name="margin-start">8</property>
        <property name="margin-top">8</property>
        <property name="name">box_main</property>
        <property name="orientation">vertical</property>
        <property name="spacing">24</property>
        <child>
          <object class="GtkGrid" id="grid_parameters">
            <property name="column-spacing">8</property>
            <property name="row-spacing">8</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkLabel" id="lbl_search_interval">
                <property name="halign">end</property>
                <property name="label" translatable="yes">Search interval:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_initial_frame">
                <property name="halign">end</property>
                <property name="label" translatable="yes">_start:</property>
                <property name="mnemonic-widget">txt_initial_frame</property>
                <property name="use-underline">1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="txt_initial_frame">
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="yes">The frame at which to start to search</property>
                <layout>
                  <property name="column">2</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_final_frame">
                <property name="halign">end</property>
                <property name="label" translatable="yes">_end:</property>
                <property name="mnemonic-widget">txt_final_frame</property>
                <property name="use-underline">1</property>
                <layout>
                  <property name="column">3</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="txt_final_frame">
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="yes">The frame at which to end to search</property>
                <layout>
                  <property name="column">4</property>
                  <property name="row">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_frame_interval">
                <property name="halign">end</property>
                <property name="label" translatable="yes">Logo duration:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_min_frame_interval">
                <property name="halign">end</property>
                <property name="label" translatable="yes">_between:</property>
                <property name="mnemonic-widget">txt_min_frame_interval</property>
                <property name="use-underline">1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="txt_min_frame_interval">
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="yes">Minimum number of frames that the logos last</property>
                <layout>
                  <property name="column">2</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_max_frame_interval">
                <property name="halign">end</property>
                <property name="label" translatable="yes">an_d:</property>
                <property name="mnemonic-widget">txt_max_frame_interval</property>
                <property name="use-underline">1</property>
                <layout>
                  <property name="column">3</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="txt_max_frame_interval">
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="yes">Maximum number of frames that the logos last</property>
                <layout>
                  <property name="column">4</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_logo_width">
                <property name="halign">end</property>
                <property name="label" translatable="yes">Logo width:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_min_logo_width">
                <property name="halign">end</property>
                <property name="label" translatable="yes">_min:</property>
                <property name="mnemonic-widget">txt_min_logo_width</property>
                <property name="use-underline">1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="txt_min_logo_width">
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="yes">Minimum width of the possible logos to consider</property>
                <layout>
                  <property name="column">2</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_max_logo_width">
                <property name="halign">end</property>
                <property name="label" translatable="yes">ma_x:</property>
                <property name="mnemonic-widget">txt_max_logo_width</property>
                <property name="use-underline">1</property>
                <layout>
                  <property name="column">3</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="txt_max_logo_width">
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="yes">Maximum width of the possible logos to consider</property>
                <layout>
                  <property name="column">4</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_logo_height">
                <property name="halign">end</property>
                <property name="label" translatable="yes">Logo height:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_min_logo_height">
                <property name="halign">end</property>
                <property name="label" translatable="yes">m_in:</property>
                <property name="mnemonic-widget">txt_min_logo_height</property>
                <property name="use-underline">1</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="txt_min_logo_height">
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="yes">Minimum height of the possible logos to consider</property>
                <layout>
                  <property name="column">2</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_max_logo_height">
                <property name="halign">end</property>
                <property name="label" translatable="yes">m_ax:</property>
                <property name="mnemonic-widget">txt_max_logo_height</property>
                <property name="use-underline">1</property>
                <layout>
                  <property name="column">3</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="txt_max_logo_height">
                <property name="focusable">1</property>
                <property name="tooltip-text" translatable="yes">Maximum height of the possible logos to consider</property>
                <layout>
                  <property name="column">4</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkProgressBar" id="progress_bar">
            <property name="valign">center</property>
            <property name="vexpand">1</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="box_buttons">
            <property name="halign">end</property>
            <property name="spacing">8</property>
            <property name="valign">end</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkButton" id="btn_find_logos">
                <property name="focusable">1</property>
                <property name="label" translatable="yes">Find _logos</property>
                <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_close">
                <property name="focusable">1</property>
                <property name="label" translatable="yes">_Close</property>
                <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
